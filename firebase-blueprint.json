  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized owner/admin identities for RBAC validation."
    },
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Public brand profile document."
    },
    "/portfolio_projects/{projectId}": {
      "schema": { "$ref": "#/entities/PortfolioProject" },
      "description": "Portfolio works showcase items."
    },
    "/media_library/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaItem" },
      "description": "Gallery photo assets and metadata."
    },
    "/modeling_groups/{groupId}": {
      "schema": { "$ref": "#/entities/ModelingGroup" },
      "description": "Modeling group and collective affiliations."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EventItem" },
      "description": "Runway events and show appearances."
    },
    "/awards/{awardId}": {
      "schema": { "$ref": "#/entities/AwardItem" },
      "description": "Honors, trophies, and full award certificates."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/ModelingCourse" },
      "description": "Offline modeling academy courses."
    },
    "/service_packages/{packageId}": {
      "schema": { "$ref": "#/entities/ServicePackage" },
      "description": "BDT collaboration service packages."
    },
    "/image_frames/{slotId}": {
      "schema": { "$ref": "#/entities/FrameImageConfig" },
      "description": "Website slot image frame settings."
    },
    "/site_config/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Public site configuration, social links, currency settings, and removed defaults."
    },
    "/student_registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/StudentRegistration" },
      "description": "PII-protected academy course registrations (owner read/update/delete only)."
    },
    "/collaboration_inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/CollaborationInquiry" },
      "description": "PII-protected brand collaboration proposals (owner read/update/delete only)."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "PII-protected contact inquiries (owner read/update/delete only)."
    }
  }
}
